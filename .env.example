# Copy to .env and adjust. Never commit .env.
VULNREPLAY_ADMIN_EMAIL=admin@vulnreplay.local
VULNREPLAY_ADMIN_PASSWORD=
# Required (>= 32 random characters) when VULNREPLAY_ENVIRONMENT=production:
VULNREPLAY_SECRET_KEY=
VULNREPLAY_ENVIRONMENT=development
POSTGRES_PASSWORD=
# Optional local LLM (Ollama-compatible). Leave empty to use deterministic analysis only.
VULNREPLAY_LLM_BASE_URL=
